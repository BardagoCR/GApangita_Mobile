# Android emulator. For physical phones replace this with the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# Physical phone: http://<computer-lan-ip>:5000/api
# iOS simulator / local browser: http://localhost:5000/api
# Deployed app: https://<api-host>/api
# Restart Expo and fully reload after changes; rebuild distributed apps.
# Required by the app's native { uri, name, type } multipart uploads on Expo 57.
EXPO_PUBLIC_USE_RN_FETCH=1
